# runtime hand-off + orchestrator state (never committed)
pipeline/
pipeline*/
*.db
*.sqlite
*.sqllite.db
.burr.db
.burr/

# ...but published result packages under results/ DO carry a snapshot of the
# pipeline artifacts and the Burr state (that is the point of a result package).
!results/**/pipeline/
!results/**/pipeline/**
!results/**/*.db

# python
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pydeps/

# scratch (leading-underscore convention)
_*.sh
_*.py
_*.txt
!**/__init__.py
!**/__main__.py

# editor/OS
.DS_Store
.idea/
.vscode/

# commons-validator example: generated config + run state (local only)
examples/commons-validator/codeweaver.toml

# alphatrans example: per-subject scaffolds, oracles, configs and run state (local only)
examples/alphatrans/subjects/
